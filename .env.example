# ---------------------------------------------------------------------------
# STADII public website — environment
#
# EVERY variable in this file is NEXT_PUBLIC_*, and that is deliberate rather
# than lazy. This app is a read-only discovery surface (ADR-0001, ADR-0018): it
# reads published Firestore documents through the Firebase Web SDK and writes
# nothing. There is no Admin SDK, no service account, no payment secret and no
# API key that grants anything a browser could not already obtain.
#
# A Firebase Web API key is an identifier, not a credential. Access is decided
# by firestore.rules, which permit anonymous reads only of ACTIVE catalogue
# records and of events that are PUBLISHED *and* PUBLIC.
#
# Copy to `.env.local` and fill in. `.env*` is git-ignored except this file.
# ---------------------------------------------------------------------------

# --- Firebase Web SDK -------------------------------------------------------
# Firebase console → Project settings → Your apps → Web app → SDK setup.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional. Set when this deployment reads a named (non-default) Firestore
# database. Leave blank for the default database.
NEXT_PUBLIC_FIRESTORE_DATABASE_ID=

# --- Site identity ----------------------------------------------------------
# The absolute origin this deployment is served from. Canonical URLs, OpenGraph
# URLs, robots.txt and sitemap.xml are all built from it, so a wrong value here
# publishes staging URLs into Google. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://stadii.co.ke

# --- Hand-off to the app ----------------------------------------------------
# This surface never sells. Purchase entry points deep-link into the STADII app,
# which authenticates and calls the backend commands.
NEXT_PUBLIC_APP_SCHEME=stadii
NEXT_PUBLIC_APP_ANDROID_URL=https://play.google.com/store/apps/details?id=ke.co.stadii
NEXT_PUBLIC_APP_IOS_URL=https://apps.apple.com/app/stadii/id000000000

# --- Contact ----------------------------------------------------------------
# Rendered on /contact and /help and in the Organization JSON-LD.
NEXT_PUBLIC_SUPPORT_EMAIL=support@stadii.co.ke
NEXT_PUBLIC_SUPPORT_PHONE=+254700000000
